DISCORD_TOKEN=
SKILLS_DIRS=skills
DB_PATH=data/yuni.db
TEST_GUILD_ID=
ADMIN_DISCORD_IDS=
QUIET_HOURS_START=02:00
QUIET_HOURS_END=06:00
# Fernet.generate_key()로 만든 urlsafe base64 32바이트 키
COOKIE_ENCRYPTION_KEY=
# gemini/claude 중 하나. 부팅 시점에만 고른다(런타임 전환 없음).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# 고른 제공자에 맞는 모델 이름을 넣는다(claude면 예: claude-haiku-5-5)
AGENT_MODEL=gemini-3.8-flash
SUMMARY_MODEL=gemini-3.5-flash-lite
# 메인 모델이 일시 오류(504 등)로 끝내 실패하면 같은 요청을 이 모델로 한 번 더 보낸다. 비우면 끈다.
# LLM_PROVIDER=gemini일 때만 쓴다.
FALLBACK_MODEL=gemini-3.5-flash-lite
# 메인 에이전트(LLM_PROVIDER)와 독립. gemini/claude 중 하나, 고른 제공자에 맞는 모델 이름을
# SEARCH_MODEL에 넣는다(claude면 예: claude-haiku-5-5)
WEBSEARCH_PROVIDER=gemini
SEARCH_MODEL=gemini-3.8-flash
WEBSEARCH_COOLDOWN_SECONDS=15
# low/medium/high 중 하나
THINKING_LEVEL=low
# instructions/full 중 하나
SKILL_LOADING_MODE=instructions
MAX_TOOL_CALLS_PER_TURN=5
MAX_TOKENS_PER_TURN=50000
